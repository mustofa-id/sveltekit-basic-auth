{
	"name": "sveltekit-basic-auth",
	"version": "0.0.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mustofa-id/sveltekit-basic-auth.git"
	},
	"author": {
		"name": "Mustofa",
		"email": "25121822+mustofa-id@users.noreply.github.com",
		"url": "https://github.com/mustofa-id"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && pnpm run prepack",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt .",
		"lint": "vp fmt --check . && vp lint .",
		"test:unit": "vp test",
		"test": "vp test --run",
		"release": "changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.7",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22",
		"eslint-plugin-svelte": "^3.12.4",
		"publint": "^0.3.14",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.0",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@10.22.0",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
